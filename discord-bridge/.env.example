# Discord bot token (from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=

# Channel IDs (right-click channel -> Copy Channel ID, with Developer Mode on)
DISCORD_ISSUE_CHANNEL_ID=
DISCORD_APPROVALS_CHANNEL_ID=
DISCORD_ADMIN_CHANNEL_ID=

# Daily AI news digest (~6 PM local) — optional overrides
# DISCORD_AI_NEWS_CHANNEL_ID=
# DISCORD_AI_NEWS_TIMEZONE=America/New_York
# DISCORD_AI_NEWS_CRON=0 18 * * *
# DISCORD_AI_NEWS_RUN_AT_START=true
# xAI Grok (https://console.x.ai/) — ranking + summaries for the digest
# XAI_API_KEY=
# Optional: model id (default grok-4-1-fast-non-reasoning)
# XAI_MODEL=grok-4-1-fast-non-reasoning

# Paperclip API (defaults work for local dev)
PAPERCLIP_API_URL=http://localhost:3100
PAPERCLIP_COMPANY_ID=
